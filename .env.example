###############################################
# Personal Expenses Application Environment Configuration
#
# NOTE: For Docker Compose usage, see .env.docker.example instead
#       This file is for direct application runs (uv run, python, etc.)
#
###############################################
# Environment Mode
#   Set to TEST or PROD (default is PROD if unset)
#   When TEST, the app prefers TEST_DB_* variables below and shows a yellow banner.
#   When PROD, the app prefers PROD_DB_* variables below.
#   Any missing prefixed vars fall back to generic DB_* values.
ENV_MODE=PROD

###############################################
# Generic Database Configuration (fallback/base)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=personal_expenses
DB_USER=postgres
DB_PASSWORD=your_password_here

###############################################
# Production Database Credentials (optional overrides when ENV_MODE=PROD)
# Uncomment and fill if you use separate production settings.
# PROD_DB_HOST=
# PROD_DB_PORT=
# PROD_DB_NAME=
# PROD_DB_USER=
# PROD_DB_PASSWORD=

###############################################
# Test / Local Database Credentials (optional overrides when ENV_MODE=TEST)
# Use these for isolated local/test data. Host should normally be localhost.
# TEST_DB_HOST=localhost
# TEST_DB_PORT=5432
# TEST_DB_NAME=personal_expenses_test
# TEST_DB_USER=postgres
# TEST_DB_PASSWORD=your_test_password_here

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Development Settings
DB_ECHO=false

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8080
APP_DEBUG=false

# Agent / Tool Access Settings
# Set either APP_API_KEY (single key) or APP_API_KEYS (comma-separated keys)
# to enforce API key auth on /api/* routes.
APP_API_KEY=
# APP_API_KEYS=key1,key2

# Comma-separated CORS origins for browser-based agent clients.
# Example: http://localhost:3000,https://my-agent-host.example
APP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM / Gemini Configuration
# Obtain an API key from Google AI Studio and set it here (do not commit real key)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
EOB_DEBUG_PREVIEW=false
EOB_USE_FILE_UPLOAD=false

# Claim email (SMTP) Configuration
# Used by the Insurance Claim Form page to email generated claim PDFs.
# Gmail: host smtp.gmail.com, port 587, user = your address, password = an App Password.
# Outlook/Hotmail: host smtp.office365.com, port 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER when blank
SMTP_FROM=
# true for implicit TLS (port 465); false uses STARTTLS
SMTP_USE_SSL=false
# Optional: default recipient when the insurance record has no Claim Submission Email
CLAIM_EMAIL_TO=
# Optional: default CC for claim emails (prefilled in the UI, editable per send)
CLAIM_EMAIL_CC=
# Optional: always BCC these addresses on claim emails (e.g. yourself, for your records)
CLAIM_EMAIL_BCC=
