###############################################
# Environment Mode
#   Set to TEST or PROD (default is PROD if unset)
#   When TEST, the app prefers TEST_DB_* variables below and shows a yellow banner.
#   When PROD, the app prefers PROD_DB_* variables below.
#   Any missing prefixed vars fall back to generic DB_* values.
ENV_MODE=PROD

###############################################
# Generic Database Configuration (fallback/base)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=personal_expenses
DB_USER=postgres
DB_PASSWORD=your_password_here

###############################################
# Production Database Credentials (optional overrides when ENV_MODE=PROD)
# Uncomment and fill if you use separate production settings.
# PROD_DB_HOST=
# PROD_DB_PORT=
# PROD_DB_NAME=
# PROD_DB_USER=
# PROD_DB_PASSWORD=

###############################################
# Test / Local Database Credentials (optional overrides when ENV_MODE=TEST)
# Use these for isolated local/test data. Host should normally be localhost.
# TEST_DB_HOST=localhost
# TEST_DB_PORT=5432
# TEST_DB_NAME=personal_expenses_test
# TEST_DB_USER=postgres
# TEST_DB_PASSWORD=your_test_password_here

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Development Settings
DB_ECHO=false

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# LLM / Gemini Configuration
# Obtain an API key from Google AI Studio and set it here (do not commit real key)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash
EOB_DEBUG_PREVIEW=false
EOB_USE_FILE_UPLOAD=false